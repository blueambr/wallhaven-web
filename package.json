{
  "name": "wallpaperslite",
  "type": "module",
  "version": "1.1.0",
  "description": "Mobile-first wallhaven.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorhavn/wallpaperslite"
  },
  "keywords": [
    "wallpapers",
    "wallhaven",
    "svelte"
  ],
  "author": {
    "name": "Vlad Gerasimovich",
    "email": "sor@sorhavn.eu"
  },
  "license": "Unlicense",
  "bugs": "https://github.com/sorhavn/wallpaperslite/issues",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.33.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "effect": "^3.22.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "nanoid": "^6.0.1",
    "prettier": "3.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-devtools-json": "^1.1.0"
  }
